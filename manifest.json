{
  "manifest_version": 3,
  "name": "Anchor Download Manager",
  "version": "1.3.0",
  "description": "Send browser downloads to Anchor for faster, resumable, multi-connection downloading.",
  "permissions": ["downloads", "downloads.ui", "contextMenus", "cookies", "storage", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["icon-data.js", "youtube.js"], "css": ["youtube.css"], "run_at": "document_idle" },
    { "matches": ["https://www.instagram.com/*"], "js": ["instagram-page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.instagram.com/*"], "js": ["icon-data.js", "instagram.js"], "css": ["instagram.css"], "run_at": "document_idle" }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anchor",
    "default_icon": { "16": "icon16-stopped.png", "32": "icon32-stopped.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "key": ""
}
